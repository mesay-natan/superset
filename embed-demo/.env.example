# Browser: public Superset origin (iframe + Embedded SDK)
VITE_SUPERSET_URL=http://localhost:9196

# Embedded dashboard UUID from Superset → Embed dashboard
VITE_EMBEDDED_DASHBOARD_ID=

# Browser: token backend base (no API key in the frontend). POST ${VITE_TOKEN_API_URL}/guest-token
VITE_TOKEN_API_URL=http://localhost:3001

# Token API + Superset (read by server/token-api.mjs via dotenv — use .env.local)
# Same value as SUPERSET_EMBED_API_KEY on the Superset server.
SUPERSET_EMBED_API_KEY=

# server/token-api.mjs only — comma-separated bases, tried in order until one connects.
# WSL + Docker Desktop: use host.docker.internal first. Or run Node on Windows and use 127.0.0.1 only.
SUPERSET_URL=http://host.docker.internal:9196,http://127.0.0.1:9196

# Optional: token API port (default 3001)
# TOKEN_API_PORT=3001
